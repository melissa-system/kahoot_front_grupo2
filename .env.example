# Copiar a .env.local y completar. Nunca subir .env.local al repositorio.

# URL base de la API NestJS (Back-Proyecto2)
VITE_API_URL=http://localhost:3000

# Supabase (solo la clave PÚBLICA: anon / publishable). Nunca la service role.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# true = usa un backend simulado en memoria (sin Supabase ni API).
# Si faltan VITE_SUPABASE_URL o VITE_SUPABASE_ANON_KEY, los mocks se activan solos.
VITE_USE_MOCKS=false
